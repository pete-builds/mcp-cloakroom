# mcp-cloakroom configuration.
#
# Every value here is optional. The defaults are chosen so that a fresh clone
# runs correctly with no configuration at all, so copy this file to .env only
# when you actually want to change something.
#
# There are NO credentials in this project and none should ever be added. Every
# upstream is a published public data file or public XML feed, none of which
# authenticate. Keeping it that way is a feature.

# ---------------------------------------------------------------- storage

# Where the SQLite store lives. In Docker this points inside a named volume so
# the multi-minute first ingest survives a container replacement.
# CLOAKROOM_DB_PATH=./data/cloakroom.db

# Run the bulk load automatically when the database is empty. Turn this off if
# you would rather run `python ingest.py` yourself.
# CLOAKROOM_AUTO_INGEST=true

# ------------------------------------------------------------- networking

# Transport, bind address, and port. The default host is 0.0.0.0 because the
# MCP SDK's own default is loopback, which silently rejects every client that
# is not on the same machine.
# MCP_TRANSPORT=streamable-http
# MCP_HOST=0.0.0.0
# MCP_PORT=3728

# ------------------------------------------------------- upstream manners

# Sent as the User-Agent to every upstream. Point it at your own fork or
# contact page if you run a modified deployment, so anyone seeing the traffic
# can identify it.
# CLOAKROOM_CONTACT_URL=

# Overrides the whole User-Agent string rather than just the contact URL.
# CLOAKROOM_USER_AGENT=

# Minimum seconds between two senate.gov requests. Raise it freely: the entire
# historical archive comes from bulk data, so a slower limit costs nothing.
# CLOAKROOM_MIN_REQUEST_INTERVAL=2.0

# How long a cached current-session feed is reused before revalidating.
# Revalidation is a conditional GET, so the usual cost is a 304 with no body.
# CLOAKROOM_REFRESH_HOURS=24

# Which senate.gov feeds are enabled, comma separated:
# hearings, members, floor, votes.
# Set this to an empty value to run entirely from bulk data with no senate.gov
# traffic whatsoever. Everything except get_schedule still works.
# CLOAKROOM_SENATE_FEEDS=hearings,members,floor,votes

# Per-request timeout in seconds.
# CLOAKROOM_HTTP_TIMEOUT=60

# ------------------------------------------------------------- data window

# Which session is treated as still in progress. Everything strictly before it
# is immutable and cached permanently. Bump these when a new session begins.
# CLOAKROOM_CURRENT_CONGRESS=119
# CLOAKROOM_CURRENT_SESSION=2

# ---------------------------------------------------------------- logging

# LOG_LEVEL=INFO
# LOG_FORMAT=text

# ------------------------------------------------------------------- auth

# Optional bearer auth on this server's own /mcp endpoint. Leave unset on a
# trusted network. If MCP_AUTH_REQUIRED is true, MCP_AUTH_TOKEN must be set and
# every client must send `Authorization: Bearer <token>`.
# MCP_AUTH_REQUIRED=false
# MCP_AUTH_TOKEN=
